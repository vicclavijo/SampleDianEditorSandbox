  <dmn:decision id="decision_construir_resultado_riesgo" name="ConstruirResultadoRiesgo">
    <dmn:variable id="var_construir_resultado_riesgo" name="ConstruirResultadoRiesgo" typeRef="tResultadoRiesgo" />
    <dmn:informationRequirement id="ir_crr_ctd">
      <dmn:requiredDecision href="#decision_clasificar_tipo_documento" />
    </dmn:informationRequirement>
    <dmn:informationRequirement id="ir_crr_cre">
      <dmn:requiredDecision href="#decision_clasificar_rango_economico" />
    </dmn:informationRequirement>
    <dmn:informationRequirement id="ir_crr_dnr">
      <dmn:requiredDecision href="#decision_determinar_nivel_riesgo" />
    </dmn:informationRequirement>
    <dmn:context id="ctx_resultado_riesgo">
      <dmn:contextEntry id="ce_tipo">
        <dmn:variable id="var_ce_tipo" name="tipoDocumento" typeRef="string" />
        <dmn:literalExpression id="le_tipo">
          <dmn:text>ClasificarTipoDocumento.tipoDocumento</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="ce_categoria">
        <dmn:variable id="var_ce_categoria" name="categoriaDocumento" typeRef="tCategoriaDocumento" />
        <dmn:literalExpression id="le_categoria">
          <dmn:text>ClasificarTipoDocumento.categoriaDocumento</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="ce_rango">
        <dmn:variable id="var_ce_rango" name="rangoEconomico" typeRef="tRangoEconomico" />
        <dmn:literalExpression id="le_rango">
          <dmn:text>ClasificarRangoEconomico</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="ce_nivel">
        <dmn:variable id="var_ce_nivel" name="nivelRiesgo" typeRef="tNivelRiesgo" />
        <dmn:literalExpression id="le_nivel">
          <dmn:text>DeterminarNivelRiesgo.nivelRiesgo</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="ce_inspeccion">
        <dmn:variable id="var_ce_inspeccion" name="requiereInspeccion" typeRef="boolean" />
        <dmn:literalExpression id="le_inspeccion">
          <dmn:text>DeterminarNivelRiesgo.requiereInspeccion</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
      <dmn:contextEntry id="ce_mensaje">
        <dmn:variable id="var_ce_mensaje" name="mensaje" typeRef="string" />
        <dmn:literalExpression id="le_mensaje">
          <dmn:text>DeterminarNivelRiesgo.mensaje</dmn:text>
        </dmn:literalExpression>
      </dmn:contextEntry>
    </dmn:context>
  </dmn:decision>
